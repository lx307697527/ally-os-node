# 本地开发：cp .env.example .env，然后 docker compose up -d
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://ally:ally@localhost:5432/ally
# Better Auth 会话签名密钥（至少 32 字符；本地随便生成一个，生产由 Terraform 托管注入）
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Better Auth 对外基准地址（生产必填，如 https://api.example.com；本地留空 = 从请求推导）
BETTER_AUTH_URL=
# 邮件发送（#22）：Resend API key。留空 = 日志模式（邮件整封打进 API 日志，
# 本地开发从日志里拿验证链接）；生产必须配置，否则验证邮件发不出去
RESEND_API_KEY=
# 发件人（Resend 只认已验证域名；本地默认值发不出去也无所谓，走日志模式）
EMAIL_FROM=Ally OS <noreply@allyos.example>
# 后台控制台对外地址：验证邮件里的链接落到它身上（留空退回 API 链接，生产必须配置）
WEB_APP_URL=http://localhost:5173
# Google OAuth 登录（#22）：client id/secret 成对配置才启用（只配一个启动即失败）；
# 都留空 = 不启用，登录页不渲染 Google 按钮。Google Cloud Console 凭据页申请，
# 授权回调地址填 http://localhost:3000/api/auth/callback/google（生产换成控制台域名）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# S3 兼容存储：本地用 MinIO；AWS 留空 S3_ENDPOINT；阿里云 OSS / 腾讯云 COS 填对应 endpoint
S3_BUCKET=ally-local
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=true
CORS_ORIGINS=http://localhost:5173
# Stripe 收款渠道（#193）：secret key 与 webhook 签名密钥成对配置才启用
# （只配一个启动即失败）；都留空 = 渠道不启用（checkout / webhook 端点答
# misconfigured）。启用同时要求 WEB_APP_URL（checkout 回跳必须是绝对地址）。
# webhook 端点：https://<api 域名>/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal 收款渠道（#193）：client id / secret / webhook id 三个一起配才启用
# （缺一启动即失败）；都留空 = 渠道不启用（checkout / webhook 端点答
# misconfigured）。启用同时要求 WEB_APP_URL（审批后的回跳必须是绝对地址）。
# webhook 端点：https://<api 域名>/api/webhooks/paypal
# API 基址留空 = 生产（api-m.paypal.com）；沙箱部署注入 sandbox 域。
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=
# Slack incoming webhook：worker 任务重试耗尽/失败时告警；留空 = 只记日志
SLACK_WEBHOOK_URL=
