# 本地开发：cp .env.example .env，然后 docker compose up -d
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://ally:ally@localhost:5432/ally
# Better Auth 会话签名密钥（至少 32 字符；本地随便生成一个，生产由 Terraform 托管注入）
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Better Auth 对外基准地址（生产必填，如 https://api.example.com；本地留空 = 从请求推导）
BETTER_AUTH_URL=
# S3 兼容存储：本地用 MinIO；AWS 留空 S3_ENDPOINT；阿里云 OSS / 腾讯云 COS 填对应 endpoint
S3_BUCKET=ally-local
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=true
CORS_ORIGINS=http://localhost:5173
# Slack incoming webhook：worker 任务重试耗尽/失败时告警；留空 = 只记日志
SLACK_WEBHOOK_URL=
