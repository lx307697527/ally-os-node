env                         = "production"
region                      = "us-east-1"
vpc_cidr                    = "10.30.0.0/16"
create_github_oidc_provider = false # staging 已创建
certificate_arn             = "arn:aws:acm:us-east-1:<account-id>:certificate/<id>"
db_instance_class           = "db.t4g.medium"
api_desired_count           = 2
web_desired_count           = 2
cors_origins                = "https://os.allynutra.com"
resend_api_key = ""
web_app_url    = "https://os.allynutra.com"
# Google OAuth（#22）：client id/secret 成对配置才启用；回调地址在 Google Cloud Console
# 填 `<控制台域名>/api/auth/callback/google`。留空 = 不启用，登录页不渲染 Google 按钮
google_client_id     = ""
google_client_secret = ""
